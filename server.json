{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.SalyyS1/mcp-slim",
  "description": "Zero-dependency MCP stdio proxy and server for schema token compaction, $ref inlining, and secret redaction.",
  "version": "0.8.0",
  "repository": {
    "url": "https://github.com/SalyyS1/mcp-slim",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-slim",
      "version": "0.8.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
